// OPTIONAL developer seed. Every setting lives in NVS and is set in setup mode (phone) or the admin
// page; the firmware builds and runs without this file. If secrets.h exists, its values are copied into NVS ONCE
// per device on a board that has no settings yet (a factory reset does not repeat it), so a developer's board
// starts in run mode without the setup walkthrough. Copy to secrets.h (gitignored). Never commit the real file.
#pragma once
#define STA_SSID "your-home-wifi"
#define STA_PASS "your-wifi-password"
#define AP_PASS "change-me-8+chars"     // password of the "fauxcloud-XXXX" Wi-Fi the console joins (>= 8 chars)
#define ADMIN_PASS "change-me-8+chars"  // initial admin password (an ADMIN_TOKEN define is accepted instead)
#define MQTT_HOST "192.168.1.10"        // broker hostname or IP ("" = MQTT off)
#define MQTT_PORT 1883
#define MQTT_USER ""                    // "" = anonymous
#define MQTT_PASS ""
